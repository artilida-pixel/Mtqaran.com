// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Village Development Fund ----------

model Region {
  id      String  @id @default(cuid())
  slug    String  @unique
  nameHy  String
  nameRu  String
  nameEn  String
  lat     Float
  lng     Float
  villages Village[]
}

model Village {
  id            String   @id @default(cuid())
  slug          String   @unique
  regionId      String
  region        Region   @relation(fields: [regionId], references: [id])
  nameHy        String
  nameRu        String
  nameEn        String
  lat           Float
  lng           Float
  population    Int?
  descriptionHy String?
  descriptionRu String?
  descriptionEn String?
  coverImage    String?
  workoutStatus String   @default("proposed") // proposed | funding | building | completed
  createdAt     DateTime @default(now())
  projects      Project[]
  photos        VillagePhoto[]

  @@index([regionId])
}

model VillagePhoto {
  id          String   @id @default(cuid())
  villageId   String
  village     Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  imageData   Bytes
  mimeType    String   @default("image/jpeg")
  caption     String?
  submittedBy String?
  contact     String?
  status      String   @default("pending") // pending | approved | rejected
  createdAt   DateTime @default(now())

  @@index([villageId])
  @@index([status])
}

model Project {
  id            String   @id @default(cuid())
  villageId     String
  village       Village  @relation(fields: [villageId], references: [id], onDelete: Cascade)
  type          String   @default("other") // workout_ground | other
  titleHy       String
  titleRu       String
  titleEn       String
  descriptionHy String?
  descriptionRu String?
  descriptionEn String?
  goalAmount    Int      // AMD
  raisedAmount  Int      @default(0) // AMD
  status        String   @default("pending") // pending | active | completed | rejected
  submittedBy   String?
  contact       String?
  createdAt     DateTime @default(now())

  @@index([villageId])
  @@index([status])
}

// ---------- MTQARAN Academy ----------

model Lecturer {
  id        String   @id @default(cuid())
  slug      String   @unique
  nameHy    String
  nameRu    String
  nameEn    String
  titleHy   String?
  titleRu   String?
  titleEn   String?
  bioHy     String?
  bioRu     String?
  bioEn     String?
  // `photo` is a path/URL for lecturers seeded from a file; `photoData` holds
  // the bytes when the photo was uploaded through the admin panel instead,
  // the same way village photos are stored.
  photo     String?
  photoData Bytes?
  photoMime String?  @default("image/jpeg")
  telegram  String?
  instagram String?
  facebook  String?
  youtube   String?
  website   String?
  order     Int      @default(0)
  lectures  Lecture[]
}

model Lecture {
  id            String    @id @default(cuid())
  slug          String    @unique
  lecturerId    String?
  lecturer      Lecturer? @relation(fields: [lecturerId], references: [id])
  titleHy       String
  titleRu       String
  titleEn       String
  descriptionHy String?
  descriptionRu String?
  descriptionEn String?
  category      String? // e.g. entrepreneurship, crafts, agriculture, leadership
  level         String? // beginner | intermediate | advanced
  durationMin   Int?
  videoUrl      String?
  coverImage    String?
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([lecturerId])
  @@index([category])
}

// ---------- News ----------

// A short news post ("a new workout ground opened", "a new lecture is up").
// Written in the admin panel, normally by pasting a post copied out of the
// Telegram channel, so every language is optional: whoever writes it fills in
// the language they have and the site falls back to another one rather than
// showing an empty card.
model NewsItem {
  id          String   @id @default(cuid())
  titleHy     String?
  titleRu     String?
  titleEn     String?
  bodyHy      String?
  bodyRu      String?
  bodyEn      String?
  imageData   Bytes?
  mimeType    String?  @default("image/jpeg")
  sourceUrl   String? // link back to the original Telegram post, if any
  published   Boolean  @default(true)
  publishedAt DateTime @default(now())
  createdAt   DateTime @default(now())

  @@index([published, publishedAt])
}
